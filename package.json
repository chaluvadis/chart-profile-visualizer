{
  "name": "chart-profile-visualizer",
  "displayName": "Helm Chart Visualizer",
  "description": "Visualize Helm charts across environments with value merging and template rendering",
  "version": "0.0.10",
  "publisher": "nomad-in-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaluvadis/chart-profile-visualizer.git"
  },
  "icon": "./images/icon-light.png",
  "bugs": {
    "url": "https://github.com/chaluvadis/chart-profile-visualizer/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages",
    "Debuggers",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/Chart.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "icon": "images/icon.svg",
          "id": "chartProfiles",
          "name": "Chart Profiles"
        }
      ]
    },
    "commands": [
      {
        "command": "chartProfiles.refreshCharts",
        "title": "Refresh Charts",
        "description": "Refresh the chart profiles tree view",
        "icon": "$(refresh)"
      },
      {
        "command": "chartProfiles.expandAll",
        "title": "Expand All Charts",
        "description": "Expand all nodes in the chart profiles tree view"
      },
      {
        "command": "chartProfiles.viewYaml",
        "title": "View YAML",
        "description": "View chart YAML (rendered or merged values)"
      },
      {
        "command": "chartProfiles.visualizeChart",
        "title": "Visualize Chart",
        "description": "Open the chart visualization with resource overview"
      },
      {
        "command": "chartProfiles.compareEnvironments",
        "title": "Compare Environments",
        "description": "Compare two environments side-by-side to see differences"
      },
      {
        "command": "chartProfiles.validateChart",
        "title": "Validate Chart",
        "description": "Validate chart configuration and check for best practices",
        "icon": "$(check)"
      },
      {
        "command": "chartProfiles.checkClusterStatus",
        "title": "Check Cluster Status",
        "description": "Check Kubernetes cluster connection status",
        "icon": "$(server)"
      },
      {
        "command": "chartProfiles.checkRuntimeState",
        "title": "Check Runtime State",
        "description": "Check runtime state of deployed resources in the cluster",
        "icon": "$(pulse)"
      },
      {
        "command": "chartProfiles.updateDependencies",
        "title": "Update Dependencies",
        "description": "Update Helm chart dependencies",
        "icon": "$(cloud-download)",
        "category": "Chart Profiles"
      },
      {
        "command": "chartProfiles.exportComparisonReport",
        "title": "Export Comparison Report",
        "description": "Export the current environment comparison report",
        "category": "Chart Profiles"
      },
      {
        "command": "chartProfiles.startWalkthrough",
        "title": "Start Walkthrough",
        "description": "Start the chart profiles walkthrough",
        "category": "Chart Profiles"
      },
      {
        "command": "chartProfiles.configureRenderContext",
        "title": "Configure Render Context",
        "description": "Set the release name and namespace used when rendering Helm templates",
        "category": "Chart Profiles",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chartProfiles.refreshCharts",
          "when": "view == chartProfiles",
          "group": "navigation"
        },
        {
          "command": "chartProfiles.checkClusterStatus",
          "when": "view == chartProfiles",
          "group": "navigation"
        },
        {
          "command": "chartProfiles.updateDependencies",
          "when": "view == chartProfiles",
          "group": "navigation"
        },
        {
          "command": "chartProfiles.configureRenderContext",
          "when": "view == chartProfiles",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "chartProfiles.visualizeChart",
          "when": "false"
        },
        {
          "command": "chartProfiles.validateChart",
          "when": "false"
        },
        {
          "command": "chartProfiles.checkRuntimeState",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Chart Profiles",
      "properties": {
        "chartProfiles.autoRefreshInterval": {
          "type": "number",
          "default": 30000,
          "description": "Interval (in milliseconds) at which the runtime state auto-refreshes."
        },
        "chartProfiles.timeouts.kubectl": {
          "type": "number",
          "default": 10000,
          "description": "Timeout (in milliseconds) for kubectl commands."
        },
        "chartProfiles.timeouts.helmTemplate": {
          "type": "number",
          "default": 30000,
          "description": "Timeout (in milliseconds) for helm template rendering."
        },
        "chartProfiles.timeouts.clusterInfo": {
          "type": "number",
          "default": 5000,
          "description": "Timeout (in milliseconds) for cluster-info commands."
        },
        "chartProfiles.showWalkthroughOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show the guided walkthrough automatically on the first activation."
        },
        "chartProfiles.renderContext.releaseName": {
          "type": "string",
          "default": "chart-profile",
          "description": "Helm release name used when rendering templates, visualizing, validating, or comparing charts. Corresponds to `.Release.Name` in Helm templates."
        },
        "chartProfiles.renderContext.namespace": {
          "type": "string",
          "default": "default",
          "description": "Kubernetes namespace passed to `helm template --namespace` during rendering, visualization, validation, and comparison."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "package": "pnpm run compile && vsce package --no-dependencies",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "tsc -p tsconfig.test.json && node test/driftSeverity.test.js && node test/kubectlDetection.test.js && node test/firstRunWalkthrough.test.js && node test/renderContext.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "js-yaml": "^5.2.1"
  },
  "license": "MIT"
}
