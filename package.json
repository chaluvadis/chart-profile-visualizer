{
  "name": "chart-profile-visualizer",
  "displayName": "Helm Chart Visualizer",
  "description": "Visualize Helm charts across environments with value merging and template rendering",
  "version": "0.0.6",
  "publisher": "nomad-in-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaluvadis/chart-profile-visualizer.git"
  },
  "icon": "./images/icon-light.png",
  "bugs": {
    "url": "https://github.com/chaluvadis/chart-profile-visualizer/issues"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages",
    "Debuggers",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/Chart.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "icon": "images/icon.svg",
          "id": "chartProfiles",
          "name": "Chart Profiles"
        }
      ]
    },
    "commands": [
      {
        "command": "chartProfiles.refreshCharts",
        "title": "Refresh Charts",
        "icon": "$(refresh)"
      },
      {
        "command": "chartProfiles.expandAll",
        "title": "Expand All Charts"
      },
      {
        "command": "chartProfiles.viewRenderedYaml",
        "title": "View Rendered YAML"
      },
      {
        "command": "chartProfiles.viewYaml",
        "title": "View YAML"
      },
      {
        "command": "chartProfiles.visualizeChart",
        "title": "Visualize Chart"
      },
      {
        "command": "chartProfiles.validateChart",
        "title": "Validate Chart",
        "icon": "$(check)"
      },
      {
        "command": "chartProfiles.checkClusterStatus",
        "title": "Check Cluster Status",
        "icon": "$(server)"
      },
      {
        "command": "chartProfiles.checkRuntimeState",
        "title": "Check Runtime State",
        "icon": "$(pulse)"
      },
      {
        "command": "chartProfiles.updateDependencies",
        "title": "Update Dependencies",
        "icon": "$(cloud-download)",
        "category": "Chart Profiles"
      },
      {
        "command": "chartProfiles.viewMergedValues",
        "title": "View Merged Values"
      },
      {
        "command": "chartProfiles.exportComparisonReport",
        "title": "Export Comparison Report",
        "icon": "$(export)"
      },
      {
        "command": "chartProfiles.startWalkthrough",
        "title": "Helm Chart Visualizer: Getting Started",
        "icon": "$(rocket)"
      }
    ],
    "configuration": {
      "title": "Helm Chart Visualizer",
      "properties": {
        "chartProfiles.showWalkthroughOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Show the guided getting-started walkthrough the first time Helm Chart Visualizer activates. Disable to suppress the prompt."
        },
        "chartProfiles.timeouts.helmTemplate": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for Helm template rendering. Increase for complex charts."
        },
        "chartProfiles.timeouts.kubectl": {
          "type": "number",
          "default": 10000,
          "description": "Timeout in milliseconds for kubectl commands."
        },
        "chartProfiles.timeouts.clusterInfo": {
          "type": "number",
          "default": 5000,
          "description": "Timeout in milliseconds for kubectl cluster-info command."
        },
        "chartProfiles.autoRefreshInterval": {
          "type": "number",
          "default": 30000,
          "description": "Interval in milliseconds for automatic runtime state refresh. Set to 0 to disable."
        },
        "chartProfiles.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging in output channel."
        },
        "chartProfiles.showOutputChannel": {
          "type": "boolean",
          "default": false,
          "description": "Automatically show the output channel when extension logs messages."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "chartProfiles.refreshCharts",
          "when": "view == chartProfiles",
          "group": "navigation"
        },
        {
          "command": "chartProfiles.checkClusterStatus",
          "when": "view == chartProfiles",
          "group": "navigation"
        },
        {
          "command": "chartProfiles.updateDependencies",
          "when": "view == chartProfiles",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "chartProfiles.visualizeChart",
          "when": "false"
        },
        {
          "command": "chartProfiles.viewRenderedYaml",
          "when": "false"
        },
        {
          "command": "chartProfiles.validateChart",
          "when": "false"
        },
        {
          "command": "chartProfiles.checkRuntimeState",
          "when": "false"
        },
        {
          "command": "chartProfiles.viewMergedValues",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "package": "pnpm run compile && vsce package --no-dependencies",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "tsc -p tsconfig.test.json && node test/driftSeverity.test.js && node test/kubectlDetection.test.js && node test/firstRunWalkthrough.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "js-yaml": "^4.1.1"
  },
  "license": "MIT"
}
